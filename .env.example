# Port the addon server will listen on
PORT=7000

# Optional: Public base URL of this addon.
# Used to build absolute proxy/manifest URLs (see src/config.js).
# Example (production); leave unset for local dev (auto-detected).
ADDON_URL=https://nuviosports.xyz

# Optional: Residential Proxy to bypass Cloudflare without Playwright
# Format: http://username:password@proxy-host.com:port
RESIDENTIAL_PROXY=

# Optional: Cloudflare Worker proxy URL (e.g., https://nuvio-proxy.yourname.workers.dev)
# If provided, edge scraping (like CDNLive) will be routed through this worker.
CF_PROXY_URL=

# --- Cloudflare worker pool budgets (.image segment de-cloaking) ---
# Comma-separated free worker origins. Leave unset to use the six defaults in
# src/services/WorkerBudget.js. The paid worker below is always excluded from
# this list, whatever you put here.
CF_WORKER_POOL=

# The single paid worker (10M requests/month included). Free workers are spent
# first; this one only takes the overflow.
CF_PAID_WORKER_URL=

# Stop each free worker at 90% of its 100k/day plan limit, so drift in the
# emission counter never turns into a hard stop.
CF_FREE_CAP_RATIO=0.9
# Stop the paid worker at 95% of the 10M/month included allowance.
CF_PAID_CAP_RATIO=0.95

# PM2 cluster instances sharing these caps (counters are per process).
# Match this to the instances value in ecosystem.config.js.
WORKER_INSTANCE_COUNT=1

# off = when both tiers are out of budget, emit the upstream URL instead of
# relaying segment bytes through /api/hlschunk on the VPS.
HLSCUNK_FALLBACK=on

# How long a segment URL keeps its assigned worker without spending more
# budget (a live playlist re-emits its whole window on every fetch).
CF_DEDUPE_TTL_MS=120000
CF_DEDUPE_MAX_ENTRIES=20000

# Periodic [WorkerBudget] usage snapshot; off silences it entirely.
WORKER_POOL_LOG=on
WORKER_POOL_LOG_INTERVAL_MS=300000

# Vavoo 24/7 Live TV Provider (Dual-Ping Architecture)
# Enables 1,800+ verified live channels across 17 countries with 0% server video bandwidth.
# Set to 'true' to enable, or 'false'/unset to keep disabled.
VAVOO_ENABLED=false

